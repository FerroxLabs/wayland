{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayland.ferroxlabs.dev/schemas/publisher-attestations-1.0.json",
  "title": "Wayland publisher attestation policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "policies"],
  "properties": {
    "contract": { "const": "wayland-publisher-attestations/1.0" },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "releaseTag",
          "repository",
          "signerWorkflow",
          "sourceRef",
          "sourceDigest",
          "predicateType",
          "oidcIssuer",
          "runner"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "active" },
          "releaseTag": { "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "repository": { "pattern": "^[^/]+/[^/]+$" },
          "signerWorkflow": { "type": "string", "minLength": 1 },
          "sourceRef": { "pattern": "^refs/" },
          "sourceDigest": { "pattern": "^[0-9a-f]{40}$" },
          "predicateType": { "const": "https://slsa.dev/provenance/v1" },
          "oidcIssuer": { "const": "https://token.actions.githubusercontent.com" },
          "runner": { "const": "github-hosted" }
        }
      }
    }
  }
}

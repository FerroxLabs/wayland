                    "enum": [
                      "unknown",
                      "invalid"
                    ]
                  },
                  "reason_code": {
                    "enum": [
                      "disconnected",
                      "invalid_credential"
                    ]
                  }
                },
                "required": [
                  "reason_code",
                  "credential_state"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "request.cost_observed"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "attempt_id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "cost_microusd": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "currency": {
                        "const": "USD"
                      },
                      "latency_ms": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "price_status": {
                        "const": "priced"
                      }
                    },
                    "required": [
                      "attempt_id",
                      "price_status",
                      "cost_microusd",
                      "currency",
                      "latency_ms"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "attempt_id": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "cost_microusd": {
                        "type": "null"
                      },
                      "currency": {
                        "type": "null"
                      },
                      "latency_ms": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "price_status": {
                        "const": "unpriced"
                      },
                      "reason_code": {
                        "const": "price_unknown"
                      }
                    },
                    "required": [
                      "attempt_id",
                      "price_status",
                      "cost_microusd",
                      "currency",
                      "latency_ms",
                      "reason_code"
                    ],
                    "type": "object"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "request.terminal"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "additionalProperties": false,
                "properties": {
                  "attempt_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "outcome": {
                    "enum": [
                      "success",
                      "failure"
                    ]
                  },
                  "reason_code": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "outcome",
                  "reason_code",
                  "attempt_id"
                ],
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "correlation": {
          "$ref": "#/$defs/correlation"
        },
        "emitted_at": {
          "format": "date-time",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "route.selected",
            "route.user_override",
            "provider.attempt_started",
            "provider.attempt_failed",
            "provider.retry_scheduled",
            "provider.fallback_selected",
            "provider.circuit_open",
            "connection.unavailable",
            "request.cost_observed",
            "request.terminal"
          ]
        },
        "evidence": {
          "type": "object"
        },
        "sequence": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "contract_version",
        "event_id",
        "event_type",
        "sequence",
        "emitted_at",
        "correlation",
        "evidence"
      ],
      "type": "object"
    },
    "fixture": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scenario": {
                "enum": [
                  "disconnected",
                  "invalid-credential"
                ]
              }
            },
            "required": [
              "scenario"
            ]
          },
          "then": {
            "properties": {
              "expected_profile": {
                "const": "no_flux"
              }
            }
          }
        }
      ],
      "properties": {
        "correlation": {
          "$ref": "#/$defs/correlation"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/event"
          },
          "type": "array"
        },
        "expected_profile": {
          "enum": [
            "flux",
            "no_flux"
          ]
        },
        "fixture_version": {
          "const": 1
        },
        "scenario": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "fixture_version",
        "scenario",
        "expected_profile",
        "correlation",
        "events"
      ],
      "type": "object"
    }
  },
  "$id": "https://fluxrouter.ai/contracts/routing-evidence/v1/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/capability"
    },
    {
      "$ref": "#/$defs/fixture"
    }
  ],
  "title": "Flux routing evidence v1"
}
